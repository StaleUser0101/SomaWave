Screen {
    background: $background;
    color: $foreground;
}
#banner {
    height: 1;
    padding: 0 2;
}
#brand {
    width: 1fr;
    height: 100%;
    content-align: left middle;
    color: $accent;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#network {
    width: auto;
    margin-left: 1;
    height: 100%;
    content-align: left middle;
    color: $muted-text;
}
#banner #open-settings {
    width: 8;
    height: 1;
    padding: 0;
    margin-left: 1;
    background: $background;
    color: $accent;
    text-style: none;
}
#banner #open-settings:focus, #banner #open-settings:hover {
    background: $station-focused;
    text-style: underline;
}
.icon-settings #banner #open-settings {
    width: 1;
}
#deck {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}
#directory, #player {
    background: $panel;
    border: round $panel-border;
    padding: 0 1;
    height: 1fr;
}
#directory {
    width: 2fr;
    margin-right: 1;
}
#player {
    width: 3fr;
    scrollbar-size: 1 1;
}
.section {
    height: 1;
    color: $accent;
    text-style: bold;
    margin: 1 0;
}
#search {
    background: $background;
    border: tall $panel-border;
}
#search:focus {
    border: tall $accent;
}
#station-views {
    height: 1;
    align-horizontal: center;
}
#station-views Button {
    height: 1;
    padding: 0;
    margin-right: 1;
    background: $background;
    color: $muted-text;
    text-style: none;
}
#station-views #view-recent {
    margin-right: 0;
}
#station-views Button.active-view {
    background: $accent;
    color: $button-color-foreground;
    text-style: bold;
}
#station-views Button:focus, #station-views Button:hover {
    text-style: bold underline;
}
#station-empty {
    height: auto;
    max-height: 1fr;
    color: $muted-text;
}
.short.narrow #search {
    height: 1;
    border: none;
}
.short.narrow #search:focus {
    background: $station-focused;
}
#stations {
    height: 1fr;
    background: $panel;
    border: none;
    scrollbar-size: 1 1;
    padding: 0;
}
#stations > .option-list--option-highlighted {
    background: $station-selected;
    color: $station-selected-text;
    text-style: bold;
}
#stations:focus > .option-list--option-highlighted {
    background: $station-focused;
    color: $station-focused-text;
}
#directory-status, .metadata-label, #playback-detail, #shortcuts {
    color: $muted-text;
}
#directory-status, .metadata-row, .metadata-value, #playback-detail {
    height: auto;
}
#directory-status {
    max-height: 2;
}
.metadata-label {
    width: 12;
    margin-right: 1;
}
.metadata-value {
    width: 1fr;
    color: $foreground;
}
#station, #track {
    text-style: bold;
}
#status {
    color: $accent;
}
#spectrum {
    height: 8;
    background: $background;
    color: $accent;
    margin: 1 0;
}
#transport, #volume-controls {
    layout: grid;
    grid-size: 4;
    grid-gutter: 0 1;
    grid-rows: 3;
    height: auto;
    margin-bottom: 1;
}
#volume-controls {
    grid-columns: 1fr 2fr 1fr 2fr;
}
#volume {
    width: 1fr;
    height: 3;
    content-align: center middle;
}
Button {
    min-width: 1;
    width: 1fr;
    text-overflow: ellipsis;
}
#shortcuts {
    padding: 0 2;
    height: auto;
    max-height: 2;
    margin-top: 1;
}
.narrow #deck {
    layout: vertical;
}
.narrow #directory, .narrow #player {
    width: 1fr;
    margin-right: 0;
}
.narrow #directory {
    height: 2fr;
}
.narrow #player {
    height: 3fr;
}
.short #shortcuts {
    display: none;
}
.short .section {
    margin: 0;
}
.tiny #transport, .tiny #volume-controls {
    grid-size: 2;
    grid-columns: 1fr 1fr;
}
.tiny #deck, .tiny #banner {
    padding: 0;
}
.compact #network {
    display: none;
}
.tiny .metadata-row {
    layout: vertical;
}
.tiny .metadata-label, .tiny .metadata-value {
    width: 100%;
    margin-right: 0;
}

SettingsScreen {
    align: center middle;
}
#settings-dialog {
    width: 52;
    max-width: 100%;
    height: 23;
    max-height: 100%;
    padding: 1 2;
    border: round $panel-border;
    background: $panel;
    color: $foreground;
}
#settings-body {
    height: 1fr;
    scrollbar-size: 1 1;
}
#settings-heading, .settings-section {
    color: $accent;
    text-style: bold;
}
.settings-section {
    margin-top: 1;
}
#settings-dialog Checkbox {
    width: 100%;
    height: auto;
    text-wrap: wrap;
}
#settings-dialog Checkbox.-on > .toggle--button {
    color: $accent;
}
#settings-footer {
    height: 1;
    margin-top: 1;
}
#settings-version {
    width: 1fr;
    color: $muted-text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#close-settings {
    width: 7;
    height: 1;
    color: $accent;
}
